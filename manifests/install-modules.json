{
  "version": 1,
  "modules": [
    {
      "id": "ds-core",
      "kind": "rules",
      "description": "Rules (common/python), 9 curated agents, platform config, MCP server catalog.",
      "paths": [
        "rules",
        "agents",
        ".claude-plugin",
        "mcp-configs"
      ],
      "targets": [
        "claude",
        "cursor",
        "antigravity",
        "codebuddy"
      ],
      "dependencies": [],
      "defaultInstall": true,
      "cost": "light",
      "stability": "stable"
    },
    {
      "id": "ds-hooks",
      "kind": "hooks",
      "description": "Runtime hook configs (2 hooks: destructive-command gate, quality-gate), hook scripts, and shared lib utilities.",
      "paths": [
        "scripts/hooks",
        "scripts/lib"
      ],
      "targets": [
        "claude",
        "cursor",
        "opencode",
        "codebuddy"
      ],
      "dependencies": [
        "ds-core"
      ],
      "defaultInstall": true,
      "cost": "medium",
      "stability": "stable"
    },
    {
      "id": "ds-llm-skills",
      "kind": "skills",
      "description": "Curated skills actually in use: deep research with search MCPs, error analysis over predictions, scholarly-work evaluation.",
      "paths": [
        "skills/deep-research",
        "skills/error-discovery",
        "skills/scholar-evaluation"
      ],
      "targets": [
        "claude",
        "cursor",
        "antigravity",
        "codex",
        "opencode",
        "codebuddy"
      ],
      "dependencies": [
        "ds-core"
      ],
      "defaultInstall": true,
      "cost": "medium",
      "stability": "stable"
    }
  ]
}
