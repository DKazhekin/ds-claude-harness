{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "exa-web-search": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "keenable": {
      "type": "http",
      "url": "https://api.keenable.ai/mcp"
    },
    "parallel": {
      "type": "http",
      "url": "https://search.parallel.ai/mcp"
    }
  }
}
